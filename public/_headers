# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Vite fingerprints every built asset (e.g. index-BIGi3UVt.js), so a given
# asset URL's contents never change — cache them hard and skip revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry is the un-fingerprinted bootstrap that points at the current
# asset hashes, so it must always be revalidated for a new deploy to propagate.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The PWA service worker (M7e) and the un-fingerprinted manifest must always be
# revalidated too, so a new deploy is never pinned by a stale cached worker.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
